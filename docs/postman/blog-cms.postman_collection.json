            }
          ]
        },
        {
          "name": "Get Posts by User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/user/1?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "user", "1"],
              "query": [
                { "key": "page", "value": "0" },
