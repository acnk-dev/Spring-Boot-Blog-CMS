          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"content\": [],\n  \"totalElements\": 0,\n  \"totalPages\": 0\n}"
            }
          ]
        },
        {
          "name": "Search Posts",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/search?query=spring+boot&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "search"],
              "query": [
                { "key": "query", "value": "spring boot", "description": "Search term (searches title and content)" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Full-text search across post titles and content. Public — no auth required.\n\nOnly searches PUBLISHED, non-deleted posts. Results sorted by `publishedAt` descending."
          },
          "response": [
