            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": 404,\n  \"error\": \"Not Found\",\n  \"message\": \"Post not found with id: 999\"\n}"
            }
          ]
        },
        {
          "name": "Get Post by Slug",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/slug/getting-started-with-spring-boot",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "slug", "getting-started-with-spring-boot"]
            },
            "description": "Get a single post by its URL-friendly slug. Public — no auth required.\n\nUsed for SEO-friendly frontend routing (e.g., `/blog/getting-started-with-spring-boot`)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Getting Started with Spring Boot\",\n  \"slug\": \"getting-started-with-spring-boot\",\n  \"status\": \"PUBLISHED\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": 404,\n  \"error\": \"Not Found\",\n  \"message\": \"Post not found with slug: unknown-slug\"\n}"
            }
          ]
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Spring Boot (Updated)\",\n  \"content\": \"Spring Boot makes it easy to create stand-alone, production-grade applications. This updated version covers the latest Spring Boot 4 features and improvements introduced in early 2026.\",\n  \"excerpt\": \"Updated guide covering Spring Boot 4 and Java 21 features.\",\n  \"categoryId\": 1,\n  \"tagIds\": [1, 2, 3],\n  \"status\": \"DRAFT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "1"]
            },
            "description": "Update an existing post. Only the post author or an ADMIN can update.\n\n**Required role:** AUTHOR or ADMIN\n\nAll fields are optional — only include what you want to change. The slug is regenerated automatically if the title changes.\n\n**Status values:** `DRAFT` | `PUBLISHED` | `ARCHIVED`"
          },
          "response": [
            {
              "name": "200 OK — post updated",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"title\": \"Getting Started with Spring Boot (Updated)\",\n  \"slug\": \"getting-started-with-spring-boot-updated\",\n  \"status\": \"DRAFT\",\n  \"updatedAt\": \"2026-03-22T11:00:00\"\n}"
            },
            {
              "name": "403 Forbidden — not the owner",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": 403,\n  \"error\": \"Forbidden\",\n  \"message\": \"You are not authorized to update this post\"\n}"
            }
          ]
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "1"]
            },
            "description": "Soft-delete a post (sets `isDeleted = true`). Only the post author or ADMIN can delete.\n\n**Required role:** AUTHOR or ADMIN\n\nThe post is not permanently removed from the database. It is excluded from all public queries."
          },
          "response": [
            {
              "name": "204 No Content — deleted",
              "status": "No Content",
              "code": 204,
              "header": []
            },
            {
              "name": "403 Forbidden",
              "status": "Forbidden",
              "code": 403,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": 403,\n  \"error\": \"Forbidden\",\n  \"message\": \"You are not authorized to delete this post\"\n}"
            }
          ]
        },
