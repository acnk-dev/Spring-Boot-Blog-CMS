# Copy this file to .env for reference, or add these as environment variables
# in your IntelliJ Run/Debug Configuration (Modify options -> Environment variables).
# Never commit real secrets.

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=abcd1234

# JWT signing secret — must be at least 256 bits (32 chars) for HMAC-SHA
JWT_SECRET=your-secret-key-min-256-bits-for-hmac-sha

# Redis (leave REDIS_PASSWORD blank for local dev with no auth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mailtrap SMTP sandbox (development/teaching only)
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password

# Google Gemini AI — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 (planned — see plans/r2-file-storage-integration.md)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=blogcms-uploads
R2_PUBLIC_URL=https://your-bucket.your-account-id.r2.dev

# blogcms-ai-service — must match that service's INTERNAL_API_KEY exactly.
AI_SERVICE_BASE_URL=http://localhost:8081
AI_SERVICE_API_KEY=your-internal-service-api-key
